# Xray 服务端预置参数模板
#
# 用法：复制为 /etc/xray-server.env（安装时会自动加载），或直接用环境变量传入。
#   sudo cp config/xray-server.env.example /etc/xray-server.env
#   curl -fsSL .../src/xray/server.sh | sudo bash -s install
#
# 优先级：命令行环境变量 > /etc/xray-server.env > 脚本内默认值
# 固定这几项后，每台新机器装出来的 UUID/密钥/shortId/SNI 都一致，
# 客户端分享链接只有 IP 不同，换机器无需重配客户端。
#
# ⚠️⚠️⚠️ 安全提醒 ⚠️⚠️⚠️
# 下面是本仓库公开的默认值，任何能看到本仓库的人都知道这套密钥。
# 仅供快速试用！正式使用请务必换成你自己独立生成的一套，在装机前执行：
#   xray uuid                       # 生成 XRAY_UUID
#   xray x25519                     # 生成 私钥(PrivateKey) 和 公钥(Password)
#   openssl rand -hex 8             # 生成 REALITY_SHORT_ID
# 然后覆盖下面的值（或用环境变量传入，环境变量优先级更高）。

# VLESS 用户 ID
XRAY_UUID=ac8a556c-f810-49b1-b659-dda6bf393974

# REALITY x25519 密钥对（私钥服务端用，公钥进客户端链接，必须成对）
REALITY_PRIVATE_KEY=aFtx98bDpNf5d1s6fBOqYqWnOWXDZtRNL0vHK9m6r0A
REALITY_PUBLIC_KEY=C1hab-V_FOMcWzdXz4IawuG5gT74B8sIyeGTTOvYZmA

# REALITY shortId（十六进制，1~16 位）
REALITY_SHORT_ID=704811f35c5d12b1

# 伪装目标域名（端口固定 443）。切勿用 www.microsoft.com（与 REALITY 借壳不兼容）。
REALITY_SNI=www.yahoo.com

# 监听端口
XRAY_PORT=443
